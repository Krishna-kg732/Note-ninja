# ================================================================
# Note Ninja - Environment Configuration
# ================================================================
# Copy this file to .env and fill in your values
# Command: cp .env.example .env
# ================================================================

# -----------------------
# Server Configuration
# -----------------------
PORT=3000
NODE_ENV=development

# -----------------------
# Notion API Configuration
# -----------------------
# Get these from: https://www.notion.so/my-integrations

# Internal Integration Token (for direct API access)
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OAuth Credentials (for user authentication)
NOTION_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_CLIENT_SECRET=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_REDIRECT_URI=http://localhost:3000/auth/callback

# -----------------------
# AI API Configuration (Google Gemini)
# -----------------------
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-2.0-flash

# -----------------------
# CORS Configuration
# -----------------------
# Add your Chrome extension ID after loading it
# Find ID at: chrome://extensions/
ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://your-extension-id-here

# -----------------------
# Rate Limiting
# -----------------------
# Window in milliseconds (default: 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------
# Session/JWT (Future)
# -----------------------
# JWT_SECRET=your-super-secret-jwt-key-here
# SESSION_SECRET=your-session-secret-here
